{
  "rules": {
    "stock": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'"
    },
    "precios": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      "$id": {
        ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 10000"
      }
    },
    "config": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'"
    },
    "pedidos": {
      ".read": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      ".indexOn": [
        "ts"
      ],
      "$pedido": {
        ".write": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1') || (!data.exists() && newData.child('estado').val() === 'pendiente')",
        ".validate": "newData.hasChildren(['ts', 'items', 'estado'])",
        "ts": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "estado": {
          ".validate": "newData.val() === 'pendiente' || newData.val() === 'confirmado' || newData.val() === 'cancelado'"
        },
        "pago": {
          ".write": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1') || !data.exists()",
          ".validate": "newData.hasChildren(['link', 'monto', 'estado'])",
          "estado": {
            ".validate": "newData.val() === 'pendiente' || (newData.val() === 'pagado' && auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1')"
          }
        }
      }
    },
    "seguimiento": {
      ".read": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".read": true,
        ".write": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1') || (!data.exists() && newData.child('etapa').val() === 'recibido') || (auth != null && root.child('entregas/' + $id + '/motorista').val() === auth.uid && newData.child('etapa').val().matches(/^(en_camino|entregado)$/))",
        "etapa": {
          ".validate": "newData.isString() && newData.val().matches(/^(recibido|preparando|listo|en_camino|entregado|cancelado)$/)"
        },
        "cancelacion": {
          ".write": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1') || (!data.exists() && data.parent().child('etapa').val() === 'recibido' && newData.child('estado').val() === 'solicitada')"
        },
        "motorista": {
          ".validate": "newData.isString() && newData.val().length < 40"
        }
      }
    },
    "motoristas": {
      ".read": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      "$uid": {
        ".read": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1') || auth.uid === $uid",
        ".write": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
        "terminos": {
          ".write": "auth != null && auth.uid === $uid && root.child('motoristas/' + $uid + '/nombre').exists()"
        },
        "enLinea": {
          ".write": "auth != null && auth.uid === $uid && root.child('motoristas/' + $uid + '/nombre').exists()",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "solicitudes": {
      ".read": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      "$id": {
        ".write": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1') || !data.exists()",
        ".validate": "newData.hasChildren(['nombre', 'tel', 'ts']) && newData.child('nombre').isString() && newData.child('nombre').val().length < 80 && newData.child('tel').isString() && newData.child('tel').val().length < 30 && (data.exists() || (newData.hasChildren(['correo', 'zona', 'moto']) && newData.child('nombre').val().length >= 5 && newData.child('nombre').val().contains(' ') && newData.child('tel').val().matches(/^[2-7][0-9][0-9][0-9][0-9][0-9][0-9][0-9]$/) && newData.child('correo').isString() && newData.child('correo').val().matches(/^[^@ ]+@[^@ ]+[.][a-z][a-z]+$/) && newData.child('zona').isString() && newData.child('zona').val().length >= 3 && newData.child('moto').isString() && newData.child('moto').val().length >= 3))",
        "$campo": {
          ".validate": "$campo.matches(/^(nombre|correo|tel|zona|moto|licencia|experiencia|disponibilidad|ts|revisada)$/) && (!newData.isString() || newData.val().length < 400)"
        }
      }
    },
    "entregas": {
      ".read": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1') || (auth != null && root.child('motoristas/' + auth.uid + '/activo').val() === true)",
      ".indexOn": [
        "creado"
      ],
      "$k": {
        ".write": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1') || ((auth != null && root.child('motoristas/' + auth.uid + '/activo').val() === true) && newData.child('pago').val() === data.child('pago').val() && ((data.child('estado').val() === 'disponible' && newData.child('estado').val() === 'asignado' && newData.child('motorista').val() === auth.uid) || (data.child('motorista').val() === auth.uid && newData.child('motorista').val() === auth.uid && newData.child('estado').val().matches(/^(asignado|recogido|entregado)$/))))",
        "motoristaNombre": {
          ".validate": "newData.isString() && newData.val().length < 60"
        }
      }
    },
    "entregasPrivado": {
      ".read": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      "$k": {
        ".read": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1') || (auth != null && root.child('entregas/' + $k + '/motorista').val() === auth.uid)",
        ".write": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'"
      }
    },
    "ubicaciones": {
      "$k": {
        ".read": true,
        ".write": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1') || (auth != null && root.child('entregas/' + $k + '/motorista').val() === auth.uid)",
        ".validate": "newData.hasChildren(['lat', 'lng', 'ts']) && newData.child('lat').isNumber() && newData.child('lng').isNumber()"
      }
    },
    "cupones": {
      ".read": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      ".write": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      "$code": {
        ".read": true,
        "usado": {
          ".write": "!data.exists() && newData.exists() && root.child('pedidos/' + newData.child('pedido').val() + '/cupon/codigo').val() === $code && data.parent().child('vence').val() > now",
          ".validate": "newData.hasChildren(['pedido', 'ts'])"
        }
      }
    },
    "cuponesInfo": {
      ".read": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      ".write": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'"
    },
    "cuponesCfg": {
      ".read": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      ".write": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'"
    },
    "ayudaCfg": {
      ".read": "true",
      ".write": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1')"
    },
    "ayuda": {
      ".read": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1')",
      ".write": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1')",
      ".indexOn": [
        "ultimo"
      ],
      "$id": {
        ".read": "$id.length >= 20 && $id.length <= 32 && $id.matches(/^[A-Za-z0-9]+$/)",
        ".validate": "$id.length >= 20 && $id.length <= 32 && $id.matches(/^[A-Za-z0-9]+$/)",
        "nombre": {
          ".write": "!data.exists()",
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "tel": {
          ".write": "!data.exists()",
          ".validate": "newData.isString() && newData.val().length <= 16 && newData.val().matches(/^[0-9 +-]*$/)"
        },
        "creado": {
          ".write": "!data.exists()",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "pedido": {
          ".write": "true",
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "ultimo": {
          ".write": "true",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "ultimoTxt": {
          ".write": "true",
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "ultimoDe": {
          ".write": "true",
          ".validate": "newData.val() === 'c' || ((auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1') && newData.val() === 't')"
        },
        "sinLeer": {
          ".write": "true",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 500"
        },
        "msgs": {
          "$m": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['de', 'txt', 't']) && newData.child('txt').isString() && newData.child('txt').val().length >= 1 && newData.child('txt').val().length <= 600 && newData.child('t').isNumber() && newData.child('t').val() <= now + 60000 && (newData.child('de').val() === 'c' || ((auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1') && newData.child('de').val() === 't'))",
            "$o": {
              ".validate": "$o.matches(/^(de|txt|t)$/)"
            }
          }
        },
        "$otro": {
          ".validate": "(auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1')"
        }
      }
    },
    "clientes": {
      ".read": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      ".write": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      ".indexOn": [
        "tel"
      ],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && !data.child('bloqueado').exists()"
      }
    },
    "tels": {
      ".read": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      ".write": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'"
    },
    "reservas": {
      ".read": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      ".write": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'"
    },
    "intentos": {
      ".read": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'",
      ".write": "auth != null && auth.uid === 'Ur4LfdU64YZstI1B8DQOUOZheIv1'"
    }
  }
}